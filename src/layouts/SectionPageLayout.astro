---
import SideALayout from './SideALayout.astro';
import '../styles/section.css';

interface Props {
  title: string;
  sectionName: string;
}

const { title, sectionName } = Astro.props;
---

<SideALayout
  title={`${title} — Side A`}
  description={`Sección ${title} de la página personal`}
  showSwitcher={false}
>
  <a class="section-back" href="/" data-section-link>BACK</a>

  <main class="main-card section-card">
    <div class="section-card__content">
      <h1 class="section-card__title">{title}</h1>
      <p class="section-card__text">
        En esta sección se hablará de mi {sectionName}
      </p>
    </div>
  </main>
</SideALayout>
