---
import SectionPageLayout from '../layouts/SectionPageLayout.astro';
import { sectionContent, sectionOrder } from '../content/sections';

export function getStaticPaths() {
  return sectionOrder.map((slug) => ({
    params: { section: slug },
    props: { slug },
  }));
}

const { slug } = Astro.props as { slug: keyof typeof sectionContent };
const content = sectionContent[slug];
---

<SectionPageLayout title={content.title} blocks={content.blocks} />
