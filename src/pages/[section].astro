---
import SectionPageLayout from '../layouts/SectionPageLayout.astro';

interface SectionProps {
  title: string;
  sectionName: string;
}

export function getStaticPaths() {
  const sections = [
    { slug: 'perfil-profesional', title: 'Perfil Profesional' },
    { slug: 'formacion', title: 'Formación' },
    { slug: 'tecnologias', title: 'Tecnologías' },
    { slug: 'proyectos', title: 'Proyectos' },
    { slug: 'organizacion', title: 'Organización' },
    { slug: 'vista-a-futuro', title: 'Vista a futuro' },
  ] as const;

  return sections.map(({ slug, title }) => ({
    params: { section: slug },
    props: { title, sectionName: title },
  }));
}

const { title, sectionName } = Astro.props as SectionProps;
---

<SectionPageLayout title={title} sectionName={sectionName} />
