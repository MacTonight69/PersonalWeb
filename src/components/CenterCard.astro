<section class="card card--center center-card" aria-labelledby="layer-title">
  <div class="center-card__content">
    <h1
      class="center-card__title typewriter-text"
      id="layer-title"
      data-typewriter
      data-typewriter-speed="88"
      aria-label="Layer: 088"
    >
      <span data-typewriter-content aria-hidden="true">Layer: 088</span>
    </h1>
    <p
      class="center-card__text typewriter-text"
      data-typewriter
      data-typewriter-speed="24"
      aria-label="You may be confused. Perhaps almost as much as I am. If you wish to discover who I am, perhaps this information will be of help. Be careful: they are watching us."
    >
      <span data-typewriter-content aria-hidden="true">
        You may be confused. Perhaps almost as much as I am. If you wish to
        discover who I am, perhaps this information will be of help. Be careful:
        they are watching us.
      </span>
    </p>
  </div>
</section>

<script>
  const typewriterElements = Array.from(
    document.querySelectorAll<HTMLElement>('[data-typewriter]'),
  );
  const intro = document.querySelector<HTMLElement>('.side-a-intro');
  const reducedMotion = window.matchMedia(
    '(prefers-reduced-motion: reduce)',
  ).matches;
  let hasStarted = false;
  let sequenceDelay = 0;

  function startTyping() {
    if (hasStarted) return;
    hasStarted = true;

    typewriterElements.forEach((element) => {
      const text = element.querySelector<HTMLElement>(
        '[data-typewriter-content]',
      );
      if (!text) return;

      const fullText = (text.textContent ?? '').replace(/\s+/g, ' ').trim();
      if (reducedMotion) return;

      const characters = Array.from(fullText);
      const speed = Number(element.dataset.typewriterSpeed) || 24;
      const initialDelay = sequenceDelay;
      sequenceDelay += characters.length * speed + 240;
      let characterIndex = 0;

      text.textContent = '';
      element.classList.add('is-typing');

      const typeNextCharacter = () => {
        if (characterIndex >= characters.length) {
          element.classList.remove('is-typing');
          return;
        }

        text.textContent += characters[characterIndex];
        characterIndex += 1;
        window.setTimeout(typeNextCharacter, speed);
      };

      window.setTimeout(typeNextCharacter, initialDelay);
    });
  }

  if (
    reducedMotion ||
    !intro ||
    document.documentElement.classList.contains('side-a-skip-intro') ||
    getComputedStyle(intro).display === 'none'
  ) {
    startTyping();
  } else {
    intro.addEventListener('animationend', (event) => {
      if (event.animationName === 'side-a-intro-dismiss') startTyping();
    });
  }
</script>

<style>
  .center-card {
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .center-card__content {
    max-width: 34rem;
    text-align: center;
  }

  .center-card__title {
    margin: 0;
    font-size: clamp(1.75rem, 2.5vw, 2.5rem);
    line-height: 1.15;
    text-wrap: balance;
    color: var(--color-title);
  }

  .center-card__text {
    margin: 1rem 0 0;
    font-size: 1.0625rem;
    color: var(--color-text);
  }

  .typewriter-text.is-typing::after {
    content: "▌";
    display: inline-block;
    margin-left: 0.12em;
    color: currentColor;
    animation: typewriter-caret 0.8s steps(1, end) infinite;
  }

  @keyframes typewriter-caret {
    50% {
      opacity: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .typewriter-text.is-typing::after {
      animation: none;
    }
  }
</style>
