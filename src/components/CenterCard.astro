---
import { sectionEntries } from '../content/sections';

const sectionData = sectionEntries.map(
  ({ id, side, title, blocks, binary }) => ({
    id,
    side,
    title,
    blocks,
    binary: binary ?? false,
  }),
);
---

<section
  class="card card--center center-card"
  data-center-card
  role="tabpanel"
  id="cm-panel"
  tabindex="0"
  aria-labelledby="cm-title"
  aria-busy="false"
>
  <div class="cm-viewport" data-cm-viewport>
    <div class="cm-content">
      <div class="cm-welcome" data-cm-welcome>
        <h1
          class="center-card__title cm-title"
          id="cm-title"
          aria-label="Layer: 088"
        >
          <span data-welcome-text data-speed="88" aria-hidden="true"
            >Layer: 088</span
          >
        </h1>
        <p
          class="center-card__text cm-text"
          id="cm-welcome-text"
          aria-label="You may be confused. Perhaps almost as much as I am. If you wish to discover who I am, perhaps this information will be of help. Be careful: they are watching us."
        >
          <span data-welcome-text data-speed="24" aria-hidden="true">
            You may be confused. Perhaps almost as much as I am. If you wish to
            discover who I am, perhaps this information will be of help. Be
            careful: they are watching us.
          </span>
        </p>
      </div>

      <div class="cm-section" data-cm-section hidden aria-hidden="true"></div>

      <div class="cm-code" data-cm-code hidden>
        <div class="cm-code__prompt" data-cm-code-prompt>
          <h1 class="center-card__title cm-title cm-code__title">
            Access code
          </h1>
          <form class="cm-code__form" data-cm-code-form novalidate>
            <label class="sr-only" for="cm-code-input">Numeric code</label>
            <input
              class="cm-code__input"
              id="cm-code-input"
              data-cm-code-input
              type="number"
              inputmode="numeric"
              step="1"
              min="0"
              autocomplete="off"
              placeholder="000"
              required
            />
            <button class="cm-code__submit" type="submit" data-cm-code-submit>
              Submit
            </button>
          </form>
          <p class="cm-code__hint" data-cm-code-hint aria-live="polite"></p>
        </div>

        <div class="cm-code__result" data-cm-code-result hidden>
          <div
            class="cm-code__entry"
            data-cm-code-entry
            data-code="616"
            hidden
          >
            <figure class="cm-code__figure">
              <img
                class="cm-code__image"
                src="/images/pentagrama-baphomet_azulado_vhs.svg"
                alt="Baphomet pentagram rendered in VHS blue"
                width="520"
                height="520"
                loading="lazy"
                decoding="async"
              />
              <figcaption class="cm-code__caption">616 // SIGIL</figcaption>
            </figure>
          </div>

          <div
            class="cm-code__entry"
            data-cm-code-entry
            data-code="333"
            hidden
          >
            <figure class="cm-code__figure">
              <img
                class="cm-code__image"
                src="/images/angels_azulado_vhs.svg"
                alt="Angels rendered in VHS blue"
                width="643"
                height="814"
                loading="lazy"
                decoding="async"
              />
              <figcaption class="cm-code__caption">333 // CHOIR</figcaption>
            </figure>
          </div>

          <div
            class="cm-code__entry"
            data-cm-code-entry
            data-code="666"
            hidden
          >
            <figure class="cm-code__figure">
              <img
                class="cm-code__image"
                src="/images/angel_sword_azulado_vhs.svg"
                alt="Angel holding a sword rendered in VHS blue"
                width="778"
                height="1000"
                loading="lazy"
                decoding="async"
              />
              <figcaption class="cm-code__caption">666 // BLADE</figcaption>
            </figure>
          </div>

          <div
            class="cm-code__entry"
            data-cm-code-entry
            data-code="369"
            hidden
          >
            <figure class="cm-code__figure">
              <img
                class="cm-code__image"
                src="/images/angels_dragon_azulado_vhs.svg"
                alt="Angels and a dragon rendered in VHS blue"
                width="795"
                height="1000"
                loading="lazy"
                decoding="async"
              />
              <figcaption class="cm-code__caption">369 // SERPENT</figcaption>
            </figure>
          </div>

          <div
            class="cm-code__entry"
            data-cm-code-entry
            data-code="777"
            hidden
          >
            <figure class="cm-code__figure">
              <img
                class="cm-code__image"
                src="/images/Minos_azulado_vhs.svg"
                alt="Minos rendered in VHS blue"
                width="1260"
                height="1032"
                loading="lazy"
                decoding="async"
              />
              <figcaption class="cm-code__caption">777 // JUDGE</figcaption>
            </figure>
          </div>

          <p
            class="cm-paragraph cm-code__random"
            data-cm-code-random
            hidden
          ></p>
        </div>
      </div>
    </div>
  </div>

  <div class="sr-only" data-cm-sr></div>
  <p class="sr-only" aria-live="polite" data-cm-status></p>
</section>

<script
  type="application/json"
  id="sections-data"
  set:html={JSON.stringify(sectionData).replace(/</g, '\\u003c')}
/>

<style>
  .center-card {
    position: relative;
    display: flex;
    align-items: stretch;
    justify-content: center;
  }

  .cm-viewport {
    flex: 1 1 auto;
    width: 100%;
    height: 100%;
    min-height: 0;
    max-height: 100%;
    overflow-y: auto;
    overscroll-behavior: contain;
    scrollbar-width: thin;
    scrollbar-color: var(--color-border) transparent;
  }

  .cm-viewport::-webkit-scrollbar {
    width: 8px;
  }

  .cm-viewport::-webkit-scrollbar-thumb {
    background-color: var(--color-border);
    border-radius: 999px;
  }

  .cm-content {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    min-height: 100%;
  }

  .center-card.is-section .cm-content {
    align-items: flex-start;
  }

  .cm-welcome {
    width: 100%;
    max-width: 34rem;
    text-align: center;
  }

  .cm-title {
    margin: 0;
    font-size: clamp(1.75rem, 2.5vw, 2.5rem);
    line-height: 1.15;
    text-wrap: balance;
    color: var(--color-title);
  }

  .cm-text {
    margin: 1rem 0 0;
    font-size: 1.0625rem;
    color: var(--color-text);
  }

  .cm-section {
    width: 100%;
    max-width: 40rem;
    margin-inline: auto;
  }

  .cm-section .cm-title {
    margin: 0 0 clamp(0.85rem, 2vh, 1.4rem);
    font-size: clamp(1.6rem, 2.6vw, 2.4rem);
    text-align: center;
  }

  .cm-body {
    display: flex;
    flex-direction: column;
    gap: clamp(0.85rem, 1.8vh, 1.2rem);
  }

  .cm-paragraph {
    margin: 0;
    font-size: clamp(0.95rem, 1.25vw, 1.08rem);
    line-height: 1.65;
    text-wrap: pretty;
    color: var(--color-text);
  }

  .cm-heading {
    margin: clamp(0.6rem, 1.6vh, 1.1rem) 0 0;
    font-size: clamp(1.2rem, 1.8vw, 1.55rem);
    line-height: 1.25;
    color: var(--color-title);
  }

  .cm-terms {
    display: flex;
    flex-direction: column;
    gap: clamp(0.8rem, 1.8vh, 1.2rem);
    margin: 0;
  }

  .cm-term {
    padding-left: 1rem;
    border-left: 2px solid var(--color-border);
  }

  .cm-term dt {
    font-weight: 700;
    line-height: 1.25;
    color: var(--color-title);
  }

  .cm-term dd {
    margin: 0.2rem 0 0;
    font-size: clamp(0.9rem, 1.2vw, 1.05rem);
    line-height: 1.6;
    text-wrap: pretty;
    color: var(--color-text);
  }

  .cm-section.is-binary .cm-paragraph,
  .cm-section.is-binary .cm-heading {
    font-family: 'Courier New', monospace;
    font-size: clamp(0.8rem, 1vw, 0.95rem);
    line-height: 1.9;
    letter-spacing: 0.02em;
    word-break: break-all;
    overflow-wrap: anywhere;
  }

  .cm-section.is-binary .cm-heading {
    margin-top: 1.6rem;
  }

  .cm-code {
    width: 100%;
    max-width: 36rem;
    margin-inline: auto;
    text-align: center;
  }

  .cm-code__title {
    margin: 0 0 clamp(0.8rem, 2vh, 1.25rem);
    font-size: clamp(1.5rem, 2.2vw, 2.1rem);
  }

  .cm-code__form {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.6rem;
  }

  .cm-code__input {
    width: min(12rem, 60%);
    padding: 0.5rem 0.75rem;
    font: inherit;
    font-size: 1.15rem;
    letter-spacing: 0.2em;
    text-align: center;
    color: var(--color-title);
    background-color: transparent;
    border: 1px solid var(--color-border);
    border-radius: 0.35rem;
    outline: none;
    appearance: textfield;
    -moz-appearance: textfield;
  }

  .cm-code__input::placeholder {
    color: var(--color-border);
    opacity: 1;
    letter-spacing: 0.2em;
  }

  .cm-code__input::-webkit-outer-spin-button,
  .cm-code__input::-webkit-inner-spin-button {
    margin: 0;
    -webkit-appearance: none;
  }

  .cm-code__input:focus-visible {
    border-color: var(--color-text);
    box-shadow:
      0 0 0 1px var(--color-text),
      0 0 18px rgba(157, 199, 240, 0.35);
  }

  .cm-code__submit {
    padding: 0.5rem 1.1rem;
    font: inherit;
    font-size: 1rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-title);
    background-color: transparent;
    border: 1px solid var(--color-border);
    border-radius: 0.35rem;
    cursor: pointer;
  }

  .cm-code__submit:hover,
  .cm-code__submit:focus-visible {
    color: var(--color-text);
    border-color: var(--color-text);
    outline: none;
  }

  .cm-code__hint {
    min-height: 1.4em;
    margin: 0.8rem 0 0;
    font-size: 0.9rem;
    color: var(--color-text);
  }

  .cm-code__result {
    width: 100%;
  }

  .cm-code__result:not([hidden]) {
    animation: cm-code-reveal 0.35s ease-out both;
  }

  .cm-code__figure {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.8rem;
    margin: 0;
  }

  .cm-code__image {
    width: auto;
    max-width: 100%;
    max-height: min(54vh, 32rem);
    margin-inline: auto;
    filter: drop-shadow(0 0 22px rgba(59, 123, 196, 0.35));
  }

  html[data-side='b'] .cm-code__image {
    filter: drop-shadow(0 0 22px rgba(255, 90, 120, 0.35));
  }

  .cm-code__caption {
    font-size: clamp(0.75rem, 1vw, 0.9rem);
    letter-spacing: 0.24em;
    text-transform: uppercase;
    color: var(--color-title);
  }

  .cm-code__random {
    text-align: left;
  }

  @keyframes cm-code-reveal {
    from {
      opacity: 0;
      transform: translateY(6px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .cm-caret {
    display: inline-block;
    margin-left: 0.08em;
    color: currentColor;
    animation: cm-caret 0.8s steps(1, end) infinite;
  }

  .cm-flash {
    position: absolute;
    inset: 0;
    z-index: 5;
    width: 100%;
    height: 100%;
    object-fit: cover;
    pointer-events: none;
  }

  @keyframes cm-caret {
    50% {
      opacity: 0;
    }
  }

  @media (max-width: 54rem) {
    .cm-viewport {
      max-height: 68dvh;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .cm-caret {
      animation: none;
    }

    .cm-code__result:not([hidden]) {
      animation: none;
    }
  }
</style>
