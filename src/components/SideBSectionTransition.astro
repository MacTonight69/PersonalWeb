---
// Transición interna de Side B.
// Evangelion.gif se muestra durante 0,7 segundos antes de navegar.
---
<div class="side-b-transition" hidden aria-hidden="true">
  <img
    class="side-b-transition__gif"
    src="/media/Evangelion.gif"
    alt=""
    width="400"
    height="300"
  />
</div>

<style>
  .side-b-transition {
    position: fixed;
    inset: 0;
    z-index: 1100;
    display: grid;
    place-items: center;
    overflow: hidden;
    background-color: #000;
    cursor: wait;
    pointer-events: auto;
  }

  .side-b-transition[hidden] {
    display: none;
  }

  .side-b-transition__gif {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: contain;
    object-position: center;
  }
</style>

<script>
  const TRANSITION_KEY = 'side-b-section-transition';
  const TRANSITION_DURATION = 700;
  const prefersReducedMotion = window.matchMedia(
    '(prefers-reduced-motion: reduce)',
  ).matches;
  const overlay = document.querySelector<HTMLElement>('.side-b-transition');
  let gif = document.querySelector<HTMLImageElement>(
    '.side-b-transition__gif',
  );
  let isTransitioning = false;

  function restartGif(): void {
    if (!gif?.parentElement) return;
    const fresh = gif.cloneNode(true) as HTMLImageElement;
    gif.replaceWith(fresh);
    gif = fresh;
  }

  document.addEventListener('click', (event) => {
    if (
      isTransitioning ||
      event.defaultPrevented ||
      event.button !== 0 ||
      event.metaKey ||
      event.ctrlKey ||
      event.shiftKey ||
      event.altKey ||
      prefersReducedMotion
    ) {
      return;
    }

    if (!(event.target instanceof Element)) return;

    const link = event.target.closest<HTMLAnchorElement>(
      'a[data-side-b-section-link]',
    );

    if (!link || link.target === '_blank' || link.hasAttribute('download')) {
      return;
    }

    const href = link.getAttribute('href');
    if (!href) return;

    event.preventDefault();
    isTransitioning = true;

    try {
      sessionStorage.setItem(TRANSITION_KEY, Date.now().toString());
    } catch {
      // Si sessionStorage falla, la navegación sigue funcionando.
    }

    if (overlay) {
      overlay.hidden = false;
    }
    restartGif();

    window.setTimeout(() => {
      window.location.assign(href);
    }, TRANSITION_DURATION);
  });
</script>
