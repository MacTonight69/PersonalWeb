---
// Transición interna entre secciones de Side A.
// Usa el SVG animado original del cerebro; sin Canvas ni WebGL.
//
// Los enlaces con `data-section-link` activan la transición y guardan
// una marca temporal en `sessionStorage`; el layout la consume para
// omitir la portada completa al llegar a la página de destino.
---
<div class="section-transition" hidden aria-hidden="true">
  <img
    class="section-transition__brain"
    src="/media/spinning_brain.svg"
    alt=""
    width="640"
    height="480"
  />
</div>

<style>
  .section-transition {
    position: fixed;
    inset: 0;
    z-index: 1100;
    display: grid;
    place-items: center;
    overflow: hidden;
    background-color: #000;
    cursor: wait;
    pointer-events: auto;
  }

  .section-transition[hidden] {
    display: none;
  }

  .section-transition__brain {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: contain;
    object-position: center;
  }
</style>

<script>
  const TRANSITION_KEY = 'side-a-brain-transition';
  const TRANSITION_DURATION = 700;
  const prefersReducedMotion = window.matchMedia(
    '(prefers-reduced-motion: reduce)',
  ).matches;
  const overlay = document.querySelector<HTMLElement>('.section-transition');
  let isTransitioning = false;

  document.addEventListener('click', (event) => {
    if (
      isTransitioning ||
      event.defaultPrevented ||
      event.button !== 0 ||
      event.metaKey ||
      event.ctrlKey ||
      event.shiftKey ||
      event.altKey ||
      prefersReducedMotion
    ) {
      return;
    }

    if (!(event.target instanceof Element)) return;

    const link = event.target.closest<HTMLAnchorElement>(
      'a[data-section-link]',
    );

    if (!link || link.target === '_blank' || link.hasAttribute('download')) {
      return;
    }

    const href = link.getAttribute('href');
    if (!href) return;

    event.preventDefault();
    isTransitioning = true;

    try {
      sessionStorage.setItem(TRANSITION_KEY, Date.now().toString());
    } catch {
      // Si sessionStorage falla, la navegación sigue funcionando.
    }

    if (overlay) {
      overlay.hidden = false;
    }

    window.setTimeout(() => {
      window.location.assign(href);
    }, TRANSITION_DURATION);
  });
</script>
