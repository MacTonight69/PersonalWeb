---
import HeaderCard from './HeaderCard.astro';
import LeftCard from './LeftCard.astro';
import CenterCard from './CenterCard.astro';
import SideBCenterCard from './SideBCenterCard.astro';
import RightCard from './RightCard.astro';
import SideBNavCard from './SideBNavCard.astro';

interface Props {
  side?: 'a' | 'b';
}

const { side = 'b' } = Astro.props;
const isSideA = side === 'a';
---

<main class="main-card">
  <HeaderCard
    bannerSrc={isSideA
      ? '/images/banner_glitch_CA.svg'
      : '/media/banner_sharingan_carmesi.svg'}
    bannerAlt="Page banner"
    bannerWidth={isSideA ? 1600 : 320}
    bannerHeight={isSideA ? 400 : 181}
  />
  <LeftCard
    profileSrc={isSideA ? '/media/PFP_Side_A.gif' : '/media/PFP_Side_B.gif'}
    profileAlt="Profile picture"
    profileWidth={isSideA ? 500 : 360}
    profileHeight={isSideA ? 370 : 360}
  />
  {isSideA ? <CenterCard /> : <SideBCenterCard />}
  {isSideA ? <RightCard /> : <SideBNavCard />}
</main>
