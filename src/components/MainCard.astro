---
import HeaderCard from './HeaderCard.astro';
import LeftCard from './LeftCard.astro';
import CenterCard from './CenterCard.astro';
import RightCard from './RightCard.astro';
---

<main class="main-card">
  <HeaderCard
    bannerSrc="/images/banner_glitch.svg"
    bannerSrcSideB="/images/banner_glitch_B.svg"
    bannerAlt="Page banner"
  />
  <LeftCard
    profileSrc="/media/PFP_Side_A.gif"
    profileSrcSideB="/media/PFP_Side_B.gif"
    profileAlt="Profile picture"
    profileWidth={500}
    profileHeight={370}
    profileWidthSideB={360}
    profileHeightSideB={360}
    profileFullWidth
  />
  <CenterCard />
  <RightCard />
</main>
