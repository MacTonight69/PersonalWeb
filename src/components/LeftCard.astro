---
interface Props {
  profileSrc?: string;
  profileAlt?: string;
  profileWidth?: number;
  profileHeight?: number;
  profileFullWidth?: boolean;
}

const {
  profileSrc = '/images/profile-placeholder.svg',
  profileAlt = 'Imagen de perfil',
  profileWidth = 120,
  profileHeight = 120,
  profileFullWidth = false,
} = Astro.props;

const fields = [
  { label: 'Usuario', value: 'Mr. Anatema' },
  { label: 'Nombre', value: 'Bautista Alejandro Cafferata' },
  { label: 'Fecha de nacimiento', value: '15 ene. 2008' },
  { label: 'País', value: 'Argentina' },
  { label: 'Idiomas', value: 'ES nat. & ENG bas.' },
] as const;
---

<section class="card card--left" aria-label="Información personal">
  <img
    class:list={[
      'left-card__image',
      { 'left-card__image--full': profileFullWidth },
    ]}
    src={profileSrc}
    alt={profileAlt}
    width={profileWidth}
    height={profileHeight}
    loading="eager"
  />

  <ul class="left-card__fields">
    {
      fields.map(({ label, value }) => (
        <li class="left-card__field">
          <span class="left-card__field-label">{label}</span>
          <span class="left-card__field-value">{value}</span>
        </li>
      ))
    }
  </ul>
</section>

<style>
  .card--left {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.5rem;
  }

  .left-card__image {
    width: clamp(5.5rem, 42%, 7.5rem);
    height: auto;
    object-fit: contain;
    border-radius: 0.5rem;
  }

  .left-card__image--full {
    width: 100%;
  }

  .left-card__fields {
    display: flex;
    flex-direction: column;
    gap: 0.875rem;
    width: 100%;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .left-card__field {
    display: flex;
    flex-direction: column;
    gap: 0.125rem;
  }

  .left-card__field-label {
    font-size: 0.8125rem;
    font-weight: 700;
    line-height: 1.2;
    color: var(--color-title);
  }

  .left-card__field-value {
    font-size: 0.9375rem;
    font-weight: 400;
    line-height: 1.35;
    color: var(--color-text);
  }

  @media (min-width: 54.0625rem) {
    .card--left {
      gap: clamp(0.5rem, 1.2vh, 0.875rem);
    }

    .left-card__image--full {
      max-height: min(19vh, 13rem);
      object-fit: contain;
    }

    .left-card__fields {
      gap: clamp(0.35rem, 0.9vh, 0.7rem);
    }

    .left-card__field-label {
      font-size: clamp(0.7rem, 0.95vw, 0.8125rem);
    }

    .left-card__field-value {
      font-size: clamp(0.75rem, 1.05vw, 0.9375rem);
    }
  }

  @media (min-width: 54.0625rem) and (max-height: 42rem) {
    .card--left {
      gap: 0.4rem;
    }

    .left-card__image--full {
      max-height: min(15vh, 7rem);
    }

    .left-card__fields {
      gap: 0.3rem;
    }

    .left-card__field-label {
      font-size: clamp(0.65rem, 0.9vw, 0.7rem);
    }

    .left-card__field-value {
      font-size: clamp(0.7rem, 1.1vw, 0.8rem);
    }
  }
</style>
