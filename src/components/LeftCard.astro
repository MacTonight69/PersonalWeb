---
interface Props {
  profileSrc?: string;
  profileSrcSideB?: string;
  profileSrcSideC?: string;
  profileAlt?: string;
  profileWidth?: number;
  profileHeight?: number;
  profileWidthSideB?: number;
  profileHeightSideB?: number;
  profileWidthSideC?: number;
  profileHeightSideC?: number;
  profileFullWidth?: boolean;
}

const {
  profileSrc = '/media/PFP_Side_A.gif',
  profileSrcSideB = '/media/PFP_Side_B.gif',
  profileSrcSideC = '/media/PFP_Side_C.gif',
  profileAlt = 'Profile picture',
  profileWidth = 120,
  profileHeight = 120,
  profileWidthSideB = profileWidth,
  profileHeightSideB = profileHeight,
  profileWidthSideC = 48,
  profileHeightSideC = 64,
  profileFullWidth = false,
} = Astro.props;

const fields = [
  { label: 'User', value: 'Mr. Anatema' },
  { label: 'Name', value: 'Bautista Alejandro Cafferata' },
  { label: 'Date of birth', value: 'Jan 15, 2008' },
  { label: 'Country', value: 'Argentina' },
  { label: 'Languages', value: 'Native Spanish & basic English' },
] as const;
---

<section class="card card--left" aria-label="Personal information">
  <img
    class:list={[
      'left-card__image',
      { 'left-card__image--full': profileFullWidth },
    ]}
    src={profileSrc}
    data-pfp
    data-src-a={profileSrc}
    data-src-b={profileSrcSideB}
    data-src-c={profileSrcSideC}
    data-width-a={profileWidth}
    data-height-a={profileHeight}
    data-width-b={profileWidthSideB}
    data-height-b={profileHeightSideB}
    data-width-c={profileWidthSideC}
    data-height-c={profileHeightSideC}
    alt={profileAlt}
    width={profileWidth}
    height={profileHeight}
    loading="eager"
  />

  <ul class="left-card__fields">
    {
      fields.map(({ label, value }) => (
        <li class="left-card__field">
          <span class="left-card__field-label">{label}</span>
          <span class="left-card__field-value">{value}</span>
        </li>
      ))
    }
  </ul>
</section>

<style>
  .card--left {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1rem;
  }

  .left-card__image {
    width: clamp(5.5rem, 42%, 7.5rem);
    height: auto;
    object-fit: contain;
    border-radius: 0.5rem;
  }

  .left-card__image--full {
    width: 100%;
  }

  html[data-side='a'] .left-card__image--full {
    width: calc(100% - 16px);
    margin: 8px;
  }

  html[data-side='b'] .left-card__image--full {
    width: calc(100% - 36px);
    margin: 18px;
    border: 2px solid rgba(255, 205, 215, 0.45);
    border-radius: 0.75rem;
    box-shadow: 0 10px 28px rgba(0, 0, 0, 0.35);
  }

  html[data-side='c'] .left-card__image--full {
    width: calc(50% - 8px);
    margin: 8px auto;
    border-radius: 0;
    image-rendering: pixelated;
  }

  .left-card__fields {
    display: flex;
    flex-direction: column;
    gap: 0.7rem;
    width: 100%;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .left-card__field {
    display: flex;
    flex-direction: column;
    gap: 0.125rem;
  }

  .left-card__field-label {
    font-size: 0.78rem;
    font-weight: 700;
    line-height: 1.2;
    color: var(--color-title);
  }

  .left-card__field-value {
    font-size: 0.88rem;
    font-weight: 400;
    line-height: 1.3;
    color: var(--color-text);
  }

  @media (min-width: 54.0625rem) {
    .card--left {
      gap: clamp(0.4rem, 1vh, 0.7rem);
    }

    .left-card__fields {
      gap: clamp(0.3rem, 0.8vh, 0.6rem);
    }

    .left-card__field-label {
      font-size: clamp(0.68rem, 0.88vw, 0.78rem);
    }

    .left-card__field-value {
      font-size: clamp(0.75rem, 0.98vw, 0.88rem);
    }
  }

  @media (min-width: 54.0625rem) and (max-height: 42rem) {
    .card--left {
      gap: 0.3rem;
    }

    .left-card__fields {
      gap: 0.25rem;
    }

    .left-card__field-label {
      font-size: clamp(0.62rem, 0.82vw, 0.68rem);
    }

    .left-card__field-value {
      font-size: clamp(0.68rem, 0.98vw, 0.75rem);
    }
  }
</style>
