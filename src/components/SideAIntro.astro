<div class="side-a-intro" aria-hidden="true">
  <img
    class="side-a-intro__carga"
    src="/media/carga_vhs.svg"
    alt=""
    width="640"
    height="480"
  />
  <img
    class="side-a-intro__gif"
    src="/media/Intro_Side_A.gif"
    alt=""
    width="480"
    height="364"
  />
</div>

<style>
  .side-a-intro {
    position: fixed;
    inset: 0;
    z-index: 1000;
    display: grid;
    place-items: center;
    overflow: hidden;
    background-color: #000;
    pointer-events: none;
    animation: side-a-intro-dismiss 0.01s linear 6.5s forwards;
  }

  .side-a-intro[hidden] {
    display: none;
  }

  .side-a-intro::after {
    content: "";
    position: absolute;
    inset: 0;
    pointer-events: none;
    background: repeating-linear-gradient(
      to bottom,
      rgba(38, 97, 156, 0.5) 0,
      rgba(38, 97, 156, 0.5) 1px,
      transparent 1px,
      transparent 4px
    );
    opacity: 0.12;
  }

  .side-a-intro img {
    grid-area: 1 / 1;
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .side-a-intro__carga {
    animation: side-a-carga-hide 0.01s linear 6s forwards;
  }

  .side-a-intro__gif {
    visibility: hidden;
    opacity: 0;
    animation: side-a-gif-show 0.01s linear 6s forwards;
  }

  @keyframes side-a-carga-hide {
    to {
      visibility: hidden;
      opacity: 0;
    }
  }

  @keyframes side-a-gif-show {
    to {
      visibility: visible;
      opacity: 1;
    }
  }

  @keyframes side-a-intro-dismiss {
    to {
      visibility: hidden;
      opacity: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .side-a-intro {
      display: none;
    }
  }

  @media print {
    .side-a-intro {
      display: none;
    }
  }
</style>

<script>
  const intro = document.querySelector<HTMLElement>('.side-a-intro');

  intro?.addEventListener('animationend', (event) => {
    if (event.animationName === 'side-a-intro-dismiss') {
      intro.hidden = true;
    }
  });
</script>
